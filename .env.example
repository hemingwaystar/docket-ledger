# Optional overrides — copy to .env (gitignored) on the host.
# BIND_ADDR: interface the two APIs publish on. Default 127.0.0.1 (host nginx
# only). Set to the VM's NetBird/overlay IP to reach the UI across the tailnet
# without exposing anything publicly. NEVER set 0.0.0.0.
#BIND_ADDR=100.x.y.z

# COOKIE_SECURE: defaults TRUE (audit) — session cookies only ride https.
# Set false ONLY on a box with no TLS front yet (direct-port sign-in over
# plain http stops working while true, by design).
#COOKIE_SECURE=false

# FORWARDED_ALLOW_IPS: which peers' X-Forwarded-* headers uvicorn trusts.
# Defaults to the docker bridge range (the nginx front). Widen only if the
# proxy reaches the containers from another network.
#FORWARDED_ALLOW_IPS=172.16.0.0/12

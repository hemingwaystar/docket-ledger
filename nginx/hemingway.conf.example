# SUPERSEDED (build 4): the real, ready-to-install config is
# nginx/helpdesk.hemingwaytechsolutions.com.conf — use that one.
# This early sketch is kept for history only; its bare /desk/ + /ledger/
# prefixing would break Docket's absolute fetch paths (bug #8).

# Host nginx — TLS termination + HSTS for the Hemingway Suite.
# The compose stack publishes only on loopback; this is the sole public door.
# Adjust server_name + certificate paths, then:
#   ln -s /etc/nginx/sites-available/hemingway.conf /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name suite.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name suite.example.com;

    ssl_certificate     /etc/letsencrypt/live/suite.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/suite.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # HSTS — start without preload; add it once you're certain
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 25m;          # attachment uploads

    location /desk/ {
        proxy_pass http://127.0.0.1:8081/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ledger/ {
        proxy_pass http://127.0.0.1:8082/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
